            "kind": "node",
            "cwd": "ts",
            "args": ["examples/control-plane-preset/node-server.ts", "--mode=relaxed", "--delivery=client-fill"]
          },
          "description": "Relaxed CSP with client-filled sections: initial shell, section endpoint and bootstrap HEAD."
        },
        {
          "id": "control-plane-preset#relaxed-streaming",
          "entrypoints": ["render.ts", "node-server.ts"],
          "class": "L1",
          "port": 8225,
          "runner": "control-plane-preset",
          "expect": { "mode": "relaxed", "delivery": "streaming" },
          "serve": {
            "kind": "node",
            "cwd": "ts",
            "args": ["examples/control-plane-preset/node-server.ts", "--mode=relaxed", "--delivery=streaming"]
          },
          "description": "Relaxed CSP with streamed sections: section content arrives in the document."
        },
        {
          "id": "control-plane-preset#strict-client-fill",
          "entrypoints": ["render.ts", "node-server.ts"],
          "class": "L1",
          "port": 8226,
          "runner": "control-plane-preset",
          "expect": { "mode": "strict", "delivery": "client-fill" },
          "serve": {
            "kind": "node",
            "cwd": "ts",
            "args": ["examples/control-plane-preset/node-server.ts", "--mode=strict", "--delivery=client-fill"]
          },
          "description": "Strict CSP with client-filled sections: no inline sources, section endpoint and bootstrap HEAD."
        },
        {
          "id": "control-plane-preset#strict-streaming",
          "entrypoints": ["render.ts", "node-server.ts"],
          "class": "L1",
          "port": 8227,
          "runner": "control-plane-preset",
          "expect": { "mode": "strict", "delivery": "streaming" },
          "serve": {
            "kind": "node",
            "cwd": "ts",
            "args": ["examples/control-plane-preset/node-server.ts", "--mode=strict", "--delivery=streaming"]
          },
          "description": "Strict CSP with streamed sections: no inline sources, section content in the document."
        }
      ]
    },
    "ts/examples/isr-blocking": {
      "rows": [
        {
