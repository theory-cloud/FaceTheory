{
  "version": 1,
  "profile": {
    "name": "facetheory-examples-local",
    "ports": {
      "first": 8210,
      "last": 8259,
      "reserved": [
        [8000, 8000],
        [8123, 8123],
        [8130, 8199],
        [8250, 8259]
