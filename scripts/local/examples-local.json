{
  "version": 1,
  "profile": {
    "name": "facetheory-examples-local",
    "ports": {
      "first": 8210,
      "last": 8259,
      "reserved": [
        [8000, 8000],
        [8123, 8123],
        [8130, 8199],
        [8250, 8259]
      ]
    },
    "apptheoryCheckout": "../AppTheory",
    "tabletheoryCheckout": "../TableTheory",
    "storage": {
      "ports": { "dynamodb": 8250, "s3": 8251 },
      "containers": {
        "dynamodb-local": {
          "image": "amazon/dynamodb-local@sha256:7ef4a2c45b58c2901e70a4f28e0953a422c2c631baaaf5e2c15e0805740c7752",
          "containerPort": 8000,
          "command": ["-jar", "DynamoDBLocal.jar", "-sharedDb", "-inMemory"]
        },
        "s3proxy": {
          "image": "andrewgaul/s3proxy@sha256:1f8915c2b4a8af22bf1fc191500f242974a458c457391b5788f9107544273dc3",
          "containerPort": 80,
          "environment": {
            "S3PROXY_AUTHORIZATION": "aws-v2-or-v4",
            "S3PROXY_IDENTITY": "dummy",
            "S3PROXY_CREDENTIAL": "dummy"
          }
        }
      }
    }
  },
  "entries": {
    "ts/examples/apptheory-lambda-url-streaming": {
      "rows": [
        {
          "id": "apptheory-lambda-url-streaming#serve",
          "entrypoints": ["handler.ts"],
          "class": "L3",
          "runner": "apptheory-local-handler",
          "unreleasedProducer": true,
          "bundle": { "entry": "handler.ts" },
          "runtime": "nodejs24.x",
          "handler": "index.handler",
          "expect": { "profile": "apptheory" },
          "gap": "The real handler and the pinned @theory-cloud/apptheory runtime run in the digest-pinned official Lambda Node image, but the Runtime Interface Emulator buffers RESPONSE_STREAM: status, headers, the 405 refusal and the complete framed body are asserted, never chunk timing or incremental delivery. The managed Function URL edge (TLS, auth, edge network) is not exercised.",
          "description": "AppTheory streaming handler over a FaceTheory app, run through the AppTheory local runner; complete buffered body, catch-all and the 405 method refusal."
        }
      ]
    },
    "ts/examples/control-plane-host-owned-contracts": {
      "rows": [
        {
          "id": "control-plane-host-owned-contracts#serve",
          "entrypoints": ["handler.ts", "node-server.ts"],
          "class": "L1",
          "port": 8228,
          "runner": "control-plane-host-owned-contracts",
          "serve": {
            "kind": "node",
            "cwd": "ts",
            "args": ["examples/control-plane-host-owned-contracts/node-server.ts"]
          },
          "description": "Host-owned control-plane gate and bounded section read through a real Node server. The host auth and section-read functions are the stub the example demonstrates; FaceTheory never owns that auth."
        }
      ]
    },
    "ts/examples/control-plane-preset": {
      "rows": [
        {
          "id": "control-plane-preset#relaxed-client-fill",
          "entrypoints": ["render.ts", "node-server.ts"],
